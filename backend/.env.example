# Copia este archivo como .env y completa los valores

# Conexión a la base de datos (Supabase, pooler de sesión)
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/postgres"

# Pagos con Webpay Plus (Transbank)
# Sin estas variables se usa el ambiente de integración de Transbank con su comercio de prueba
# público: no mueve dinero real. Para producción, Transbank entrega el código de comercio y la
# API key al certificar el comercio.
# WEBPAY_AMBIENTE=produccion
# WEBPAY_CODIGO_COMERCIO=
# WEBPAY_API_KEY=

# Dirección pública del backend (Transbank devuelve aquí al comprador) y del sitio
# API_URL_PUBLICA=http://localhost:3000
# FRONTEND_URL=http://localhost:3001

# Correos (recuperación de contraseña)
# Sin SMTP_HOST se usa una bandeja de prueba de Ethereal: los correos no llegan a nadie y se ven en
# https://ethereal.email con la cuenta que el backend muestra en consola (se guarda en .correo-pruebas.json).
# Para producción, un servidor SMTP real, por ejemplo Resend (smtp.resend.com, puerto 465, usuario "resend").
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="UBIK - Eventos y Comunidad" <no-responder@ubik.cl>

# Inteligencia artificial (resumen y moderación de reseñas) con la API de Claude
# Se obtiene en console.anthropic.com (cuenta y cobro aparte de la suscripción de claude.ai).
# Sin ANTHROPIC_API_KEY el sitio funciona en "modo de prueba": resúmenes simples generados con reglas
# y moderación solo con reglas locales. Conviene fijar un límite de gasto mensual en la consola.
# ANTHROPIC_API_KEY=
# IA_MODELO=claude-opus-5-5
