# Copia este archivo como .env y completa los valores

# Conexión a la base de datos (Supabase, pooler de sesión)
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/postgres"

# Pagos con Webpay Plus (Transbank)
# Sin estas variables se usa el ambiente de integración de Transbank con su comercio de prueba
# público: no mueve dinero real. Para producción, Transbank entrega el código de comercio y la
# API key al certificar el comercio.
# WEBPAY_AMBIENTE=produccion
# WEBPAY_CODIGO_COMERCIO=
# WEBPAY_API_KEY=

# Dirección pública del backend (Transbank devuelve aquí al comprador) y del sitio
# API_URL_PUBLICA=http://localhost:3000
# FRONTEND_URL=http://localhost:3001
