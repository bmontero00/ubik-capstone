datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ATTENDEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Estado de la cuenta, lo administra un ADMIN (motivo obligatorio si no es ACTIVE)
  status               AccountStatus          @default(ACTIVE)
  statusReason         String?
  statusChangedAt      DateTime?
  statusChangedById    String?
  statusChangedBy      User?                  @relation("StatusChangedBy", fields: [statusChangedById], references: [id])
  statusChangedUsers   User[]                 @relation("StatusChangedBy")
  eventStatusChanges   Event[]                @relation("EventStatusChangedBy")
  entradasBitacora     BitacoraEvento[]       @relation("AutorBitacora")
  compras              Compra[]
  parametrosEditados   ParametroPlataforma[]  @relation("ParametroEditadoPor")
  historialParametros  HistorialParametro[]
  historialCargos      HistorialCargoEvento[]
  condicionesRevisadas Event[]                @relation("CondicionRevisadaPor")

  // Recuperación de contraseña por correo. Al cambiar la contraseña se registra la fecha y las
  // sesiones abiertas antes de ese momento dejan de ser válidas.
  contrasenaCambiadaEn DateTime?
  codigosRecuperacion  CodigoRecuperacion[]

  // Relación con los eventos creados por el usuario
  events Event[]

  // Datos de verificación (solo para usuarios ORGANIZER)
  organizerProfile OrganizerProfile?  @relation("ProfileOwner")
  reviewedProfiles OrganizerProfile[] @relation("ReviewedBy")
  organizerReviews OrganizerReview[]

  // Reseñas de eventos: las que escribió como asistente y las que recibió como organizador
  resenasEscritas  Resena[]        @relation("ResenaAutor")
  resenasRecibidas Resena[]        @relation("ResenaOrganizador")
  resumenResenas   ResumenResenas?

  @@map("users")
}

// Código de 6 dígitos para recuperar la contraseña: se envía por correo, se guarda cifrado,
// vence a los pocos minutos y sirve una sola vez
model CodigoRecuperacion {
  id            String    @id @default(uuid())
  codigoHash    String
  expiraEn      DateTime
  intentos      Int       @default(0) // intentos fallidos al ingresarlo
  usadoEn       DateTime? // se usó para cambiar la contraseña
  anuladoEn     DateTime? // se pidió otro código o se agotaron los intentos
  fechaCreacion DateTime  @default(now())

  usuarioId String
  usuario   User   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, fechaCreacion])
  @@map("codigos_recuperacion")
}

// ACTIVE: uso normal. UNDER_REVIEW: cuenta reportada, solo puede ver eventos.
// SUSPENDED: no puede iniciar sesión.
enum AccountStatus {
  ACTIVE
  UNDER_REVIEW
  SUSPENDED
}

enum EventStatus {
  PUBLISHED
  UNDER_REVIEW
  POSTPONED
  CANCELLED
  FINISHED
}

enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
}

// Solicitud de verificación de un organizador. Un administrador debe
// aprobarla antes de que el organizador pueda publicar eventos.
model OrganizerProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation("ProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  rut              String            @unique
  phone            String
  organizationName String?
  eventDescription String
  socialUrl        String?
  status           OrganizerStatus   @default(PENDING)
  rejectionReason  String?
  approvalNote     String?
  approvalSeenAt   DateTime? // Cuándo vio el aviso de cuenta verificada (null = aún no lo ve)
  reviewedAt       DateTime?
  reviewedById     String?
  reviewedBy       User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  submittedAt      DateTime          @default(now()) // Fecha del último envío (cambia al re-postular)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reviews          OrganizerReview[]

  @@map("organizer_profiles")
}

// Historial de revisiones: cada aprobación o rechazo guarda una copia de la
// solicitud tal como estaba, porque al re-postular el perfil se sobrescribe.
model OrganizerReview {
  id               String           @id @default(uuid())
  profileId        String
  profile          OrganizerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  decision         OrganizerStatus
  reason           String
  reviewedAt       DateTime         @default(now())
  reviewedById     String?
  reviewedBy       User?            @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  // Copia de la solicitud revisada
  submittedAt      DateTime
  applicantName    String
  rut              String
  phone            String
  organizationName String?
  eventDescription String
  socialUrl        String?

  @@index([profileId, reviewedAt])
  @@map("organizer_reviews")
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  // Los administra un ADMIN desde el mantenedor de categorías
  color  String  @default("#818cf8") // color de la categoría (badge, mapa y portada por defecto)
  emoji  String  @default("✨") // emoji de la portada por defecto
  activa Boolean @default(true) // oculta = no se ofrece para eventos nuevos (los existentes la conservan)
  orden  Int     @default(0)
  events Event[]

  @@map("categories")
}

model Event {
  id                String    @id @default(uuid())
  title             String
  description       String?
  price             Float     @default(0)
  date              DateTime
  address           String
  latitude          Float
  longitude         Float
  imageUrl          String?
  // Fecha en que la IA aprobó la imagen; null si no se pudo verificar (el admin la revisa)
  imagenModeradaEn  DateTime?
  // Portada diseñada con IA para eventos sin imagen: { paleta, patron, emoji, frase }
  portadaIa         Json?
  // Lo que propone el organizador cuando elige la categoría "Otra" (ej. "Mascotas")
  categoriaSugerida String?
  // Edad mínima para asistir (14, 16 o 18); null = todo público. No se puede cambiar una vez publicado
  edadMinima        Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Llaves foráneas y relaciones
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id])

  // Estado del evento, lo administra un ADMIN
  status            EventStatus @default(PUBLISHED)
  statusReason      String?
  statusChangedAt   DateTime?
  statusChangedById String?
  statusChangedBy   User?       @relation("EventStatusChangedBy", fields: [statusChangedById], references: [id])

  // Anuncios del organizador y registro de cambios, visibles en el detalle del evento
  bitacora BitacoraEvento[]

  // Compras de entradas (o confirmaciones de asistencia si el evento es gratuito)
  compras  Compra[]
  entradas Entrada[]
  resenas  Resena[]

  // Cargo por servicio de UBIK: se fija al crear el evento con el % vigente y no cambia si después
  // se modifica el % de la plataforma. "price" es lo que recibe el organizador por entrada; el
  // público paga price + cargo (redondeado a la decena).
  porcentajeCargo Float @default(0)

  // Condición especial de cargo que el organizador solicita al crear el evento. Mientras está
  // PENDIENTE la venta de entradas queda en pausa (el evento se ve con el aviso "próximamente").
  estadoCondicion        EstadoCondicionEspecial?
  justificacionCondicion String?
  porcentajeSolicitado   Float?
  respuestaCondicion     String?
  condicionRevisadaEn    DateTime?
  condicionRevisadaPorId String?
  condicionRevisadaPor   User?                    @relation("CondicionRevisadaPor", fields: [condicionRevisadaPorId], references: [id])
  historialCargos        HistorialCargoEvento[]

  // Oferta del organizador: % de descuento sobre el precio de todos los tipos de entrada (el cargo
  // se calcula sobre el precio rebajado). Sin "ofertaHasta" dura hasta el evento.
  porcentajeOferta Int?
  ofertaHasta      DateTime?
  ofertaCreadaEn   DateTime?

  // Tipos de entrada (General, VIP, Expositor...). "price" guarda el precio más bajo ("desde").
  // La suma de los cupos de los tipos es igual al aforo; los eventos antiguos no tienen aforo.
  aforo        Int?
  tiposEntrada TipoEntrada[]

  // Estacionamiento: gratuito (solo informativo) o pagado (se vende con cupos junto a las entradas)
  estacionamiento             TipoEstacionamiento?
  precioEstacionamiento       Float?
  cuposEstacionamiento        Int?
  indicacionesEstacionamiento String?

  @@map("events")
}

enum TipoBitacora {
  CREACION // el evento se publicó
  ANUNCIO // mensaje del organizador (o del equipo UBIK) a la comunidad
  CAMBIO_DATOS // se modificaron datos del evento (fecha, lugar, precio…)
  CAMBIO_ESTADO // cambió el estado (postergado, cancelado, en revisión…)
}

// Bitácora del evento. Los cambios se registran solos; los anuncios los escribe el organizador.
model BitacoraEvento {
  id            String       @id @default(uuid())
  tipo          TipoBitacora
  titulo        String?
  mensaje       String?
  // Detalle de lo modificado: [{ campo, anterior, nuevo }]
  cambios       Json?
  fechaCreacion DateTime     @default(now())

  eventoId String
  evento   Event  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  autorId  String
  autor    User   @relation("AutorBitacora", fields: [autorId], references: [id])

  @@index([eventoId, fechaCreacion])
  @@map("bitacora_eventos")
}

enum EstadoCompra {
  PENDIENTE_PAGO // datos listos, esperando el pago (se reservan las entradas por unos minutos)
  PAGADA // pago aprobado: entradas válidas
  CONFIRMADA // evento gratuito: asistencia confirmada, sin pago
  CANCELADA // el comprador abandonó el pago
  EXPIRADA // venció el plazo para pagar
}

enum TipoEstacionamiento {
  GRATUITO
  PAGADO
}

// Tipo de entrada de un evento: nombre, precio para el organizador y cupo
model TipoEntrada {
  id            String   @id @default(uuid())
  nombre        String
  descripcion   String?
  precio        Float // lo que recibe el organizador por entrada (sin cargo ni oferta)
  cupo          Int? // null en eventos antiguos (sin aforo)
  orden         Int      @default(0)
  fechaCreacion DateTime @default(now())

  eventoId String
  evento   Event     @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  entradas Entrada[]

  @@index([eventoId, orden])
  @@map("tipos_entrada")
}

// Una compra agrupa las entradas de un evento que adquiere un asistente en una sola transacción
model Compra {
  id                      String       @id @default(uuid())
  codigo                  String       @unique // código legible para el comprador, ej. UBK-7F3K9Q
  estado                  EstadoCompra
  cantidad                Int
  precioUnitario          Float // precio final por entrada que pagó el asistente (incluye el cargo)
  total                   Float
  // Desglose al momento de la compra (no cambia aunque después se edite el evento)
  precioBase              Float        @default(0) // lo que recibe el organizador por entrada
  porcentajeCargo         Float        @default(0)
  cargoServicio           Float        @default(0) // cargo total de la compra (todas las entradas)
  // Estacionamiento comprado junto a las entradas (sin cargo por servicio)
  cantidadEstacionamiento Int          @default(0)
  precioEstacionamiento   Float        @default(0) // por vehículo
  codigoEstacionamiento   String?      @unique
  medioPago               String? // ej. WEBPAY, MERCADO_PAGO (SIMULADO mientras no exista pasarela)
  fechaCreacion           DateTime     @default(now())
  expiraEn                DateTime? // límite para pagar una compra pendiente
  fechaPago               DateTime?

  eventoId      String
  evento        Event             @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  compradorId   String
  comprador     User              @relation(fields: [compradorId], references: [id], onDelete: Cascade)
  entradas      Entrada[]
  // Intentos de pago en la pasarela (un pago rechazado o anulado se puede reintentar)
  transacciones TransaccionPago[]

  @@index([compradorId, fechaCreacion])
  @@index([eventoId, estado])
  @@map("compras")
}

enum EstadoTransaccion {
  INICIADA // el comprador fue enviado a la pasarela y aún no vuelve
  AUTORIZADA // pago aprobado por el banco
  RECHAZADA // el banco rechazó el pago
  ANULADA // el comprador abandonó el formulario de pago o se agotó su tiempo
  REVERSADA // se aprobó cuando la compra ya no estaba vigente y se devolvió el dinero
  ERROR // la pasarela no pudo confirmar el pago
}

// Un intento de pago de una compra en la pasarela (por ahora Webpay Plus de Transbank).
// Guarda los datos del comprobante que se muestran al comprador.
model TransaccionPago {
  id                 String            @id @default(uuid())
  medio              String // WEBPAY
  token              String            @unique // token de la transacción en la pasarela
  ordenCompra        String            @unique // buy_order enviado a Transbank (máx. 26 caracteres)
  monto              Float
  estado             EstadoTransaccion @default(INICIADA)
  codigoRespuesta    Int? // response_code de Transbank (0 = aprobado)
  codigoAutorizacion String?
  tipoPago           String? // VD débito, VN crédito, VC cuotas, SI/S2/NC sin interés, VP prepago
  cuotas             Int?
  montoCuota         Float?
  ultimosDigitos     String? // últimos 4 dígitos de la tarjeta
  fechaTransaccion   DateTime? // fecha informada por Transbank
  respuesta          Json? // respuesta completa de la pasarela, para soporte
  fechaCreacion      DateTime          @default(now())
  fechaActualizacion DateTime          @updatedAt

  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  @@index([compraId, fechaCreacion])
  @@map("transacciones_pago")
}

// Entrada nominativa: cada una queda a nombre de un asistente
model Entrada {
  id            String   @id @default(uuid())
  codigo        String   @unique // código que se presenta en el acceso
  nombre        String
  apellido      String
  rut           String // normalizado "12345678-5"
  telefono      String // "+56912345678"
  correo        String
  fechaCreacion DateTime @default(now())
  // Lo que pagó el público por esta entrada (incluye cargo y oferta) y el cargo por servicio incluido
  precio        Float    @default(0)
  cargo         Float    @default(0)

  compraId      String
  compra        Compra       @relation(fields: [compraId], references: [id], onDelete: Cascade)
  eventoId      String
  evento        Event        @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  tipoEntradaId String?
  tipoEntrada   TipoEntrada? @relation(fields: [tipoEntradaId], references: [id])

  @@index([eventoId, rut])
  @@index([tipoEntradaId])
  @@map("entradas")
}

enum EstadoCondicionEspecial {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Parámetros de la plataforma editables por un administrador (ej. PORCENTAJE_CARGO_SERVICIO)
model ParametroPlataforma {
  clave              String   @id
  valor              String
  descripcion        String?
  fechaActualizacion DateTime @updatedAt
  actualizadoPorId   String?
  actualizadoPor     User?    @relation("ParametroEditadoPor", fields: [actualizadoPorId], references: [id])

  @@map("parametros_plataforma")
}

// Quién cambió un parámetro, cuándo, de qué valor a cuál y por qué
model HistorialParametro {
  id            String   @id @default(uuid())
  clave         String
  valorAnterior String?
  valorNuevo    String
  motivo        String
  fecha         DateTime @default(now())
  adminId       String
  admin         User     @relation(fields: [adminId], references: [id])

  @@index([clave, fecha])
  @@map("historial_parametros")
}

// Cambios del % de cargo de un evento (condiciones especiales aprobadas o ajustes de un admin)
model HistorialCargoEvento {
  id                 String   @id @default(uuid())
  porcentajeAnterior Float
  porcentajeNuevo    Float
  motivo             String
  fecha              DateTime @default(now())
  eventoId           String
  evento             Event    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  adminId            String
  admin              User     @relation(fields: [adminId], references: [id])

  @@index([eventoId, fecha])
  @@map("historial_cargos_evento")
}

// Reseña de un asistente sobre un evento finalizado al que compró o confirmó entradas. Califica al
// organizador del evento: una por asistente y evento. El organizador puede responderla públicamente.
model Resena {
  id             String    @id @default(uuid())
  estrellas      Int // de 1 a 5
  comentario     String // entre 20 y 500 caracteres
  respuesta      String? // respuesta pública del organizador (una por reseña)
  fechaRespuesta DateTime?
  fechaCreacion  DateTime  @default(now())
  fechaEdicion   DateTime? // última vez que el autor la modificó

  eventoId      String
  evento        Event  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  autorId       String
  autor         User   @relation("ResenaAutor", fields: [autorId], references: [id], onDelete: Cascade)
  // Copia del organizador del evento para calcular su promedio sin recorrer sus eventos
  organizadorId String
  organizador   User   @relation("ResenaOrganizador", fields: [organizadorId], references: [id], onDelete: Cascade)

  @@unique([eventoId, autorId])
  @@index([organizadorId, fechaCreacion])
  @@map("resenas")
}

// Resumen de las reseñas de un organizador generado con IA (o con el modo de prueba si no hay API key).
// Se regenera en segundo plano cuando cambian sus reseñas; uno por organizador.
model ResumenResenas {
  id              String   @id @default(uuid())
  organizadorId   String   @unique
  organizador     User     @relation(fields: [organizadorId], references: [id], onDelete: Cascade)
  resumen         String // párrafo breve y público
  destacados      Json // string[]: lo más valorado
  aMejorar        Json // string[]: lo que se puede mejorar
  sugerencias     Json // string[]: recomendaciones privadas para el organizador
  totalResenas    Int // reseñas consideradas
  promedio        Float
  origen          String // IA | PRUEBA
  modelo          String? // modelo de IA usado (null en modo de prueba)
  fechaGeneracion DateTime @default(now())

  @@map("resumenes_resenas")
}
